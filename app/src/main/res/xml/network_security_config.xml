<?xml version="1.0" encoding="utf-8"?>
<!-- The bridge is plain HTTP on loopback and a user may point a preset at an HTTP
     endpoint, so cleartext stays permitted. The domain-config that used to repeat this
     for localhost was redundant, and its presence made the system refuse to initialise
     any additional process of this app with "multiple conflicting per-domain rules". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
